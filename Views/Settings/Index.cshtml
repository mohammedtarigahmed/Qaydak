@model Qaydak.Models.BusinessSettings

@{
    ViewData["Title"] = "بيانات النشاط";
}

<h2>بيانات النشاط</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-action="Index" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label>اسم النشاط</label>
        <input asp-for="BusinessName" class="form-control" />
        <span asp-validation-for="BusinessName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>الرقم الضريبي (15 رقم)</label>
        <input asp-for="VatNumber" class="form-control" />
        <span asp-validation-for="VatNumber" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">حفظ</button>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}