@{
    ViewData["Title"] = "الرئيسية";
}

<div class="text-center" style="padding: 60px 20px;">
    <h1 class="mb-3">قيدك</h1>
    <p class="text-muted mb-4">نظام فوترة ومحاسبة مبسّط لأصحاب الأعمال الصغيرة</p>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a href="/Home/Dashboard" class="btn btn-primary btn-lg">الذهاب للوحة التحكم</a>
    }
    else
    {
        <a href="/Account/Login" class="btn btn-primary btn-lg">تسجيل الدخول</a>
    }
</div>