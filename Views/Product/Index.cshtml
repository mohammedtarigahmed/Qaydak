@model List<Qaydak.Models.Product>

@{
    ViewData["Title"] = "المنتجات والخدمات";
}

<h2>المنتجات والخدمات</h2>

<a href="/Product/Create" class="btn btn-primary mb-3">+ إضافة منتج/خدمة</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>الاسم</th>
            <th>السعر الافتراضي</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.DefaultPrice.ToString("F2")</td>
                <td>
                    <a href="/Product/Edit/@product.Id">تعديل</a>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@product.Id" />
                        <button type="submit" class="btn btn-link btn-sm text-danger p-0" onclick="return confirm('متأكد عايز تحذف؟')">حذف</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>