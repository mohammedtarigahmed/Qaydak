@model Qaydak.Models.Customer

@{
    ViewData["Title"] = "حذف العميل";
}

<h2 class="mb-3">تأكيد حذف العميل</h2>

<div class="card">
    <div class="card-body">
        <p>متأكد عايز تحذف العميل ده؟</p>

        <dl class="row">
            <dt class="col-sm-2">الاسم</dt>
            <dd class="col-sm-10">@Model.Name</dd>

            <dt class="col-sm-2">رقم الهاتف</dt>
            <dd class="col-sm-10">@Model.PhoneNumber</dd>

            <dt class="col-sm-2">البريد الإلكتروني</dt>
            <dd class="col-sm-10">@Model.Email</dd>

            <dt class="col-sm-2">العنوان</dt>
            <dd class="col-sm-10">@Model.Address</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">نعم، احذف</button>
            <a href="/Customer" class="btn btn-outline-secondary">إلغاء</a>
        </form>
    </div>
</div>