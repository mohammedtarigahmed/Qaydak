@model List<Qaydak.Models.Customer>

@{
    ViewData["Title"] = "العملاء";
}

<h2>قائمة العملاء</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<a href="/Customer/Create" class="btn btn-primary mb-3">+ إضافة عميل جديد</a>

<div class="mb-3">
    <input type="text" id="searchBox" class="form-control" placeholder="بحث بالاسم أو الهاتف" style="max-width: 300px;" value="@ViewBag.Search" />
</div>

<div id="resultsContainer">
    @await Html.PartialAsync("_CustomerTablePartial", Model)
</div>

@section Scripts {
    <script>
        const searchBox = document.getElementById('searchBox');
        const resultsContainer = document.getElementById('resultsContainer');
        let debounceTimer;

        function loadResults(search, page = 1) {
            fetch(`/Customer/SearchPartial?search=${encodeURIComponent(search)}&page=${page}`)
                .then(response => response.text())
                .then(html => {
                    resultsContainer.innerHTML = html;
                    attachPageLinks();
                });
        }

        function attachPageLinks() {
            document.querySelectorAll('.search-page-link').forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    const page = this.getAttribute('data-page');
                    loadResults(searchBox.value, page);
                });
            });
        }

        searchBox.addEventListener('input', function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                loadResults(searchBox.value);
            }, 300);
        });

        attachPageLinks();
    </script>
}