@model List<Qaydak.Models.Customer>

@{
    ViewData["Title"] = "العملاء";
}

<h2>قائمة العملاء</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<a href="/Customer/Create" class="btn btn-primary mb-3">+ إضافة عميل جديد</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>الاسم</th>
            <th>رقم الهاتف</th>
            <th>العنوان</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.Name</td>
                <td>@customer.PhoneNumber</td>
                <td>@customer.Address</td>
                <td>
                    <a href="/Customer/Edit/@customer.Id">تعديل</a> |
                    <a href="/Customer/Delete/@customer.Id">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>