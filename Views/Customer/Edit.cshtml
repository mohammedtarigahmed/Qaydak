@model Qaydak.Models.Customer

@{
    ViewData["Title"] = "تعديل العميل";
}

<h2>تعديل بيانات العميل</h2>

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="RowVersion" />

    <div class="mb-3">
        <label>الاسم</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>رقم الهاتف (بصيغة دولية، مثال: 966501234567)</label>
        <input asp-for="PhoneNumber" class="form-control" placeholder="مثال: 966501234567" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>العنوان</label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">حفظ التعديلات</button>
    <a href="/Customer" class="btn btn-secondary">إلغاء</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}