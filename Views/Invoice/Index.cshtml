@model List<Qaydak.Models.Invoice>

@{
    ViewData["Title"] = "الفواتير";
}

<h2>قائمة الفواتير</h2>

<a href="/Invoice/Create" class="btn btn-primary mb-3">+ فاتورة جديدة</a>

<form method="get" class="mb-3 d-flex gap-2">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث برقم الفاتورة أو اسم العميل" style="max-width: 300px;" />
    <button type="submit" class="btn btn-outline-primary">بحث</button>
</form>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>رقم الفاتورة</th>
            <th>العميل</th>
            <th>التاريخ</th>
            <th>الحالة</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var invoice in Model)
        {
            <tr>
                <td>@invoice.InvoiceNumber</td>
                <td>@invoice.Customer?.Name</td>
                <td>@invoice.IssueDate.ToString("yyyy-MM-dd")</td>
                <td>@(invoice.IsPaid ? "مدفوعة" : "غير مدفوعة")</td>
                <td>
                    <a href="/Invoice/Details/@invoice.Id">تفاصيل</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="/Invoice?page=@i&search=@ViewBag.Search">@i</a>
                </li>
            }
        </ul>
    </nav>
}