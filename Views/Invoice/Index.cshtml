@model List<Qaydak.Models.Invoice>

@{
    ViewData["Title"] = "الفواتير";
}

<h2>قائمة الفواتير</h2>

<a href="/Invoice/Create" class="btn btn-primary mb-3">+ فاتورة جديدة</a>

<div class="mb-3">
    <input type="text" id="searchBox" class="form-control" placeholder="بحث برقم الفاتورة أو اسم العميل" style="max-width: 300px;" value="@ViewBag.Search" />
</div>

<div id="resultsContainer">
    @await Html.PartialAsync("_InvoiceTablePartial", Model)
</div>

@section Scripts {
    <script>
        const searchBox = document.getElementById('searchBox');
        const resultsContainer = document.getElementById('resultsContainer');
        let debounceTimer;

        function loadResults(search, page = 1) {
            fetch(`/Invoice/SearchPartial?search=${encodeURIComponent(search)}&page=${page}`)
                .then(response => response.text())
                .then(html => {
                    resultsContainer.innerHTML = html;
                    attachPageLinks();
                });
        }

        function attachPageLinks() {
            document.querySelectorAll('.search-page-link').forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    const page = this.getAttribute('data-page');
                    loadResults(searchBox.value, page);
                });
            });
        }

        searchBox.addEventListener('input', function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                loadResults(searchBox.value);
            }, 300);
        });

        attachPageLinks();
    </script>
}