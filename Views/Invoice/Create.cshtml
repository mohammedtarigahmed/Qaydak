@model Qaydak.Models.InvoiceWithItemsViewModel

@{
    ViewData["Title"] = "فاتورة جديدة";
    var customers = ViewBag.Customers as List<Qaydak.Models.Customer>;
    var products = ViewBag.Products as List<Qaydak.Models.Product>;
}

<h2>فاتورة جديدة</h2>

<form asp-action="Create" method="post" id="invoiceForm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label>العميل</label>
        @if (customers == null || !customers.Any())
        {
            <p class="text-danger">لا يوجد عملاء مسجلين بعد. <a href="/Customer/Create">اضغط هنا لإضافة عميل أولاً</a></p>
        }
        else
        {
            <select asp-for="CustomerId" class="form-control">
                <option value="">-- اختر عميل --</option>
                @foreach (var c in customers)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
            <span asp-validation-for="CustomerId" class="text-danger"></span>
        }
    </div>

    <div class="mb-3">
        <label>نسبة الضريبة %</label>
        <input asp-for="VatRate" class="form-control" />
        <span asp-validation-for="VatRate" class="text-danger"></span>
    </div>

    <hr />
    <h4>البنود</h4>

    <div id="itemsContainer">
        <div class="item-row row mb-2">
            <div class="col-md-3">
                <select class="form-control product-select">
                    <option value="">-- اختر من الكتالوج (اختياري) --</option>
                    @if (products != null)
                    {
                        @foreach (var p in products)
                        {
                            <option value="@p.Id" data-name="@p.Name" data-price="@p.DefaultPrice">@p.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4">
                <input name="Items[0].Description" class="form-control item-description" placeholder="الوصف" />
            </div>
            <div class="col-md-2">
                <input name="Items[0].Quantity" type="number" step="0.01" class="form-control" placeholder="الكمية" value="1" />
            </div>
            <div class="col-md-2">
                <input name="Items[0].UnitPrice" type="number" step="0.01" class="form-control item-price" placeholder="السعر" />
            </div>
            <div class="col-md-1">
                <button type="button" class="btn btn-danger btn-sm remove-item">×</button>
            </div>
        </div>
    </div>

    <button type="button" id="addItemBtn" class="btn btn-outline-primary btn-sm mb-3">+ إضافة بند</button>

    <hr />
    <button type="submit" class="btn btn-success">حفظ الفاتورة</button>
    <a href="/Invoice" class="btn btn-secondary">إلغاء</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        let itemIndex = 1;

        function buildProductOptions() {
            const select = document.querySelector('.product-select');
            return select ? select.innerHTML : '';
        }

        function attachProductSelectHandler(row) {
            const select = row.querySelector('.product-select');
            const descriptionInput = row.querySelector('.item-description');
            const priceInput = row.querySelector('.item-price');

            select.addEventListener('change', function () {
                const selectedOption = select.options[select.selectedIndex];
                if (selectedOption.value) {
                    descriptionInput.value = selectedOption.getAttribute('data-name');
                    priceInput.value = selectedOption.getAttribute('data-price');
                }
            });
        }

        document.querySelectorAll('.item-row').forEach(attachProductSelectHandler);

        document.getElementById('addItemBtn').addEventListener('click', function () {
            const container = document.getElementById('itemsContainer');
            const newRow = document.createElement('div');
            newRow.className = 'item-row row mb-2';
            newRow.innerHTML = `
                <div class="col-md-3">
                    <select class="form-control product-select">${buildProductOptions()}</select>
                </div>
                <div class="col-md-4">
                    <input name="Items[${itemIndex}].Description" class="form-control item-description" placeholder="الوصف" />
                </div>
                <div class="col-md-2">
                    <input name="Items[${itemIndex}].Quantity" type="number" step="0.01" class="form-control" placeholder="الكمية" value="1" />
                </div>
                <div class="col-md-2">
                    <input name="Items[${itemIndex}].UnitPrice" type="number" step="0.01" class="form-control item-price" placeholder="السعر" />
                </div>
                <div class="col-md-1">
                    <button type="button" class="btn btn-danger btn-sm remove-item">×</button>
                </div>
            `;
            container.appendChild(newRow);
            attachProductSelectHandler(newRow);
            itemIndex++;
        });

        document.getElementById('itemsContainer').addEventListener('click', function (e) {
            if (e.target.classList.contains('remove-item')) {
                e.target.closest('.item-row').remove();
            }
        });
    </script>
}