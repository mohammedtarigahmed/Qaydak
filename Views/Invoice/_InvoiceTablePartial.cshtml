@model List<Qaydak.Models.Invoice>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>رقم الفاتورة</th>
            <th>العميل</th>
            <th>التاريخ</th>
            <th>الحالة</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var invoice in Model)
        {
            <tr>
                <td>@invoice.InvoiceNumber</td>
                <td>@invoice.Customer?.Name</td>
                <td>@invoice.IssueDate.ToString("yyyy-MM-dd")</td>
                <td>
                    @if (invoice.IsVoided)
                    {
                        <text>ملغاة</text>
                    }
                    else if (invoice.IsOverdue())
                    {
                        <span class="badge bg-danger">متأخرة</span>
                    }
                    else
                    {
                        @(invoice.IsPaid ? "مدفوعة" : "غير مدفوعة")
                    }
                </td>
                <td>
                    <a href="/Invoice/Details/@invoice.Id">تفاصيل</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link search-page-link" href="#" data-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}