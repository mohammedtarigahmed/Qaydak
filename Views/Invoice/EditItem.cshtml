@model Qaydak.Models.InvoiceItem

@{
    ViewData["Title"] = "تعديل البند";
}

<h2>تعديل البند</h2>

<form asp-action="EditItem" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="InvoiceId" />

    <div class="mb-3">
        <label>الوصف</label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>الكمية</label>
        <input asp-for="Quantity" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>سعر الوحدة</label>
        <input asp-for="UnitPrice" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="UnitPrice" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">حفظ التعديلات</button>
    <a href="/Invoice/Details/@Model.InvoiceId" class="btn btn-secondary">إلغاء</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}