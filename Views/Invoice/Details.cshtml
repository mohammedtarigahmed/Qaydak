@model Qaydak.Models.Invoice

@{
    ViewData["Title"] = "تفاصيل الفاتورة";
    decimal subtotal = Model.GetSubtotal();
    decimal vatAmount = Model.GetVatAmount();
    decimal total = Model.GetTotal();
    var newItem = ViewBag.NewItem as Qaydak.Models.InvoiceItem;
    var products = ViewBag.Products as List<Qaydak.Models.Product>;
}

<a href="/Invoice" class="btn btn-outline-secondary btn-sm mb-3">← رجوع لقائمة الفواتير</a>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.IsVoided)
{
    <div class="alert alert-warning">هذه الفاتورة ملغاة ولا يمكن التعديل عليها</div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h3 class="mb-1">فاتورة رقم: @Model.InvoiceNumber</h3>
                <p class="text-muted mb-1">العميل: @Model.Customer?.Name</p>
                <p class="text-muted mb-1">التاريخ: @Model.IssueDate.ToString("yyyy-MM-dd")</p>
                @if (Model.DueDate.HasValue)
                {
                    <p class="mb-0">
                        تاريخ الاستحقاق: @Model.DueDate.Value.ToString("yyyy-MM-dd")
                        @if (Model.IsOverdue())
                        {
                            <span class="badge bg-danger">متأخرة</span>
                        }
                    </p>
                }
                <div class="mt-2">
                    @if (Model.IsVoided)
                    {
                        <span class="badge bg-secondary">ملغاة</span>
                    }
                    else if (Model.IsPaid)
                    {
                        <span class="badge bg-success">مدفوعة بالكامل</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">غير مكتملة الدفع</span>
                    }
                </div>
            </div>
            <div class="col-md-4 text-center">
                <img src="/Invoice/QrCode/@Model.Id" alt="QR Code" style="width: 120px;" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h6 class="text-muted mb-3">الإجراءات</h6>
        <div class="d-flex gap-2 flex-wrap mb-2">
            <a href="/Invoice/DownloadPdf/@Model.Id" target="_blank" class="btn btn-primary">عرض / تحميل PDF</a>
            <button type="button" class="btn btn-success" onclick="openWhatsApp(@Model.Id)">إرسال عبر واتساب</button>
            <button type="button" class="btn btn-outline-secondary" onclick="openEmail(@Model.Id)">إرسال بالإيميل</button>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="/Invoice/Duplicate/@Model.Id" class="btn btn-outline-info">نسخ الفاتورة</a>
            @if (!Model.IsVoided)
            {
                <a href="/Invoice/Edit/@Model.Id" class="btn btn-outline-primary">تعديل بيانات الفاتورة</a>

                <form asp-action="Void" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-danger" onclick="return confirm('متأكد عايز تلغي الفاتورة دي؟ لا يمكن التراجع عن هذا الإجراء')">إلغاء الفاتورة</button>
                </form>
            }
        </div>
    </div>
</div>

@if (!Model.IsPaid && !Model.IsVoided)
{
    <div class="card mb-3">
        <div class="card-body">
            <h6 class="text-muted mb-3">تسجيل دفعة</h6>
            <p class="mb-2">المتبقي: <strong>@((total - Model.PaidAmount).ToString("F2"))</strong> من إجمالي @total.ToString("F2")</p>
            <form asp-action="RecordPayment" method="post" class="d-flex gap-2 flex-wrap align-items-end">
                <input type="hidden" name="id" value="@Model.Id" />
                <div>
                    <label class="form-label mb-1">المبلغ</label>
                    <input name="amount" type="number" step="0.01" class="form-control" style="max-width: 200px;" />
                </div>
                <button type="submit" class="btn btn-primary">تسجيل الدفعة</button>
            </form>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <h6 class="text-muted mb-3">البنود</h6>
        <div class="table-responsive">
            <table class="table table-bordered mb-0">
                <thead>
                    <tr>
                        <th>الوصف</th>
                        <th>الكمية</th>
                        <th>سعر الوحدة</th>
                        <th>الإجمالي</th>
                        @if (!Model.IsVoided)
                        {
                            <th></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Description</td>
                            <td>@item.Quantity.ToString("0.##")</td>
                            <td>@item.UnitPrice.ToString("0.##")</td>
                            <td>@((item.Quantity * item.UnitPrice).ToString("0.##"))</td>
                            @if (!Model.IsVoided)
                            {
                                <td>
                                    <a href="/Invoice/EditItem/@item.Id">تعديل</a>
                                    <form asp-action="DeleteItem" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="invoiceId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-link btn-sm text-danger p-0" onclick="return confirm('متأكد عايز تحذف البند ده؟')">حذف</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3 text-end" style="max-width: 300px; margin-inline-start: auto;">
            <div class="d-flex justify-content-between">
                <span>المجموع الفرعي:</span>
                <strong>@subtotal.ToString("F2")</strong>
            </div>
            @if (Model.DiscountAmount > 0)
            {
                <div class="d-flex justify-content-between text-danger">
                    <span>الخصم:</span>
                    <strong>-@Model.DiscountAmount.ToString("F2")</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span>بعد الخصم:</span>
                    <strong>@Model.GetDiscountedSubtotal().ToString("F2")</strong>
                </div>
            }
            <div class="d-flex justify-content-between">
                <span>الضريبة (@Model.VatRate%):</span>
                <strong>@vatAmount.ToString("F2")</strong>
            </div>
            <hr class="my-2" />
            <div class="d-flex justify-content-between fs-5">
                <span>الإجمالي:</span>
                <strong>@total.ToString("F2")</strong>
            </div>
        </div>
    </div>
</div>

@if (!Model.IsVoided)
{
    <div class="card mb-3">
        <div class="card-body">
            <h6 class="text-muted mb-3">إضافة بند جديد</h6>
            <form asp-action="AddItem" method="post" id="addItemForm">
                <input type="hidden" name="InvoiceId" value="@Model.Id" />

                <div class="mb-3">
                    <label>اختر من الكتالوج (اختياري)</label>
                    <select class="form-control" id="productSelect">
                        <option value="">-- اختر من الكتالوج --</option>
                        @if (products != null)
                        {
                            @foreach (var p in products)
                            {
                                <option value="@p.Id" data-name="@p.Name" data-price="@p.DefaultPrice">@p.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-5 mb-3">
                        <label>الوصف</label>
                        <input name="Description" id="itemDescription" class="form-control" value="@newItem?.Description" />
                        <span class="text-danger">@Html.ValidationMessage("Description")</span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label>الكمية</label>
                        <input name="Quantity" type="number" step="0.01" class="form-control" value="@(newItem?.Quantity ?? 1)" />
                        <span class="text-danger">@Html.ValidationMessage("Quantity")</span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label>سعر الوحدة</label>
                        <input name="UnitPrice" id="itemUnitPrice" type="number" step="0.01" class="form-control" value="@newItem?.UnitPrice" />
                        <span class="text-danger">@Html.ValidationMessage("UnitPrice")</span>
                    </div>
                </div>

                <button type="submit" class="btn btn-success">إضافة البند</button>
            </form>
        </div>
    </div>

    <script>
        document.getElementById('productSelect').addEventListener('change', function () {
            const selectedOption = this.options[this.selectedIndex];
            if (selectedOption.value) {
                document.getElementById('itemDescription').value = selectedOption.getAttribute('data-name');
                document.getElementById('itemUnitPrice').value = selectedOption.getAttribute('data-price');
            }
        });
    </script>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function openWhatsApp(invoiceId) {
            fetch(`/Invoice/WhatsAppLink/${invoiceId}`)
                .then(response => response.text())
                .then(url => {
                    if (url.startsWith('http')) {
                        window.open(url, '_blank');
                    } else {
                        alert(url);
                    }
                });
        }

        function openEmail(invoiceId) {
            fetch(`/Invoice/EmailLink/${invoiceId}`)
                .then(response => response.text())
                .then(url => {
                    if (url.startsWith('mailto:')) {
                        const link = document.createElement('a');
                        link.href = url;
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                    } else {
                        alert(url);
                    }
                });
        }
    </script>
}