@model Qaydak.Models.Invoice

@{
    ViewData["Title"] = "تفاصيل الفاتورة";
    decimal subtotal = Model.GetSubtotal();
    decimal vatAmount = Model.GetVatAmount();
    decimal total = Model.GetTotal();
    var newItem = ViewBag.NewItem as Qaydak.Models.InvoiceItem;
}

<h2>فاتورة رقم: @Model.InvoiceNumber</h2>
<a href="/Invoice" class="btn btn-outline-secondary mb-3">← رجوع لقائمة الفواتير</a>
<p>العميل: @Model.Customer?.Name</p>
<p>التاريخ: @Model.IssueDate.ToString("yyyy-MM-dd")</p>

<div class="mb-3">
    <img src="/Invoice/QrCode/@Model.Id" alt="QR Code" style="width: 150px;" />
</div>

<a href="/Invoice/DownloadPdf/@Model.Id" class="btn btn-outline-primary mb-3">تحميل PDF</a>

<h4>البنود</h4>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>الوصف</th>
            <th>الكمية</th>
            <th>سعر الوحدة</th>
            <th>الإجمالي</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Description</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice</td>
                <td>@(item.Quantity * item.UnitPrice)</td>
            </tr>
        }
    </tbody>
</table>

<p><strong>المجموع الفرعي:</strong> @subtotal</p>
<p><strong>الضريبة (@Model.VatRate%):</strong> @vatAmount</p>
<p><strong>الإجمالي:</strong> @total</p>

<hr />

<h4>إضافة بند جديد</h4>
<form asp-action="AddItem" method="post">
    <input type="hidden" name="InvoiceId" value="@Model.Id" />

    <div class="mb-3">
        <label>الوصف</label>
        <input name="Description" class="form-control" value="@newItem?.Description" />
        <span class="text-danger">@Html.ValidationMessage("Description")</span>
    </div>

    <div class="mb-3">
        <label>الكمية</label>
        <input name="Quantity" type="number" step="0.01" class="form-control" value="@(newItem?.Quantity ?? 1)" />
        <span class="text-danger">@Html.ValidationMessage("Quantity")</span>
    </div>

    <div class="mb-3">
        <label>سعر الوحدة</label>
        <input name="UnitPrice" type="number" step="0.01" class="form-control" value="@newItem?.UnitPrice" />
        <span class="text-danger">@Html.ValidationMessage("UnitPrice")</span>
    </div>

    <button type="submit" class="btn btn-success">إضافة البند</button>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}