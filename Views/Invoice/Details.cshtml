@model Qaydak.Models.Invoice

@{
    ViewData["Title"] = "تفاصيل الفاتورة";
    decimal subtotal = Model.GetSubtotal();
    decimal vatAmount = Model.GetVatAmount();
    decimal total = Model.GetTotal();
    var newItem = ViewBag.NewItem as Qaydak.Models.InvoiceItem;
    var products = ViewBag.Products as List<Qaydak.Models.Product>;
}

<h2>فاتورة رقم: @Model.InvoiceNumber</h2>

<a href="/Invoice" class="btn btn-outline-secondary mb-3">← رجوع لقائمة الفواتير</a>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.IsVoided)
{
    <div class="alert alert-warning">هذه الفاتورة ملغاة ولا يمكن التعديل عليها</div>
}

<p>العميل: @Model.Customer?.Name</p>
<p>التاريخ: @Model.IssueDate.ToString("yyyy-MM-dd")</p>

<div class="mb-3">
    <img src="/Invoice/QrCode/@Model.Id" alt="QR Code" style="width: 150px;" />
</div>

<div class="mb-3 d-flex gap-2 flex-wrap">
    <a href="/Invoice/DownloadPdf/@Model.Id" target="_blank" class="btn btn-outline-primary">عرض / تحميل PDF</a>

    <button type="button" class="btn btn-success" onclick="openWhatsApp(@Model.Id)">إرسال عبر واتساب</button>

    <button type="button" class="btn btn-outline-secondary" onclick="openEmail(@Model.Id)">إرسال بالإيميل</button>

    @if (!Model.IsVoided)
    {
        <a href="/Invoice/Edit/@Model.Id" class="btn btn-outline-primary">تعديل بيانات الفاتورة</a>

        <form asp-action="Void" method="post" class="d-inline">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-outline-danger" onclick="return confirm('متأكد عايز تلغي الفاتورة دي؟ لا يمكن التراجع عن هذا الإجراء')">إلغاء الفاتورة</button>
        </form>
    }
</div>

<div class="mb-3">
    <strong>حالة الدفع:</strong> @(Model.IsPaid ? "مدفوعة بالكامل ✅" : $"غير مكتملة (مدفوع {Model.PaidAmount.ToString("F2")} من {total.ToString("F2")})")
</div>

@if (!Model.IsPaid && !Model.IsVoided)
{
    <form asp-action="RecordPayment" method="post" class="mb-4">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="mb-2">
            <label>تسجيل دفعة</label>
            <input name="amount" type="number" step="0.01" class="form-control" style="max-width: 200px;" />
        </div>
        <button type="submit" class="btn btn-primary">تسجيل الدفعة</button>
    </form>
}

<h4>البنود</h4>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>الوصف</th>
            <th>الكمية</th>
            <th>سعر الوحدة</th>
            <th>الإجمالي</th>
            @if (!Model.IsVoided)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Description</td>
                <td>@item.Quantity.ToString("0.##")</td>
                <td>@item.UnitPrice.ToString("0.##")</td>
                <td>@((item.Quantity * item.UnitPrice).ToString("0.##"))</td>
                @if (!Model.IsVoided)
                {
                    <td>
                        <a href="/Invoice/EditItem/@item.Id">تعديل</a>
                        <form asp-action="DeleteItem" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="invoiceId" value="@Model.Id" />
                            <button type="submit" class="btn btn-link btn-sm text-danger p-0" onclick="return confirm('متأكد عايز تحذف البند ده؟')">حذف</button>
                        </form>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<p><strong>المجموع الفرعي:</strong> @subtotal.ToString("F2")</p>
<p><strong>الضريبة (@Model.VatRate%):</strong> @vatAmount.ToString("F2")</p>
<p><strong>الإجمالي:</strong> @total.ToString("F2")</p>

@if (!Model.IsVoided)
{
    <hr />

    <h4>إضافة بند جديد</h4>
    <form asp-action="AddItem" method="post" id="addItemForm">
        <input type="hidden" name="InvoiceId" value="@Model.Id" />

        <div class="row mb-3">
            <div class="col-md-4">
                <label>اختر من الكتالوج (اختياري)</label>
                <select class="form-control" id="productSelect">
                    <option value="">-- اختر من الكتالوج --</option>
                    @if (products != null)
                    {
                        @foreach (var p in products)
                        {
                            <option value="@p.Id" data-name="@p.Name" data-price="@p.DefaultPrice">@p.Name</option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label>الوصف</label>
            <input name="Description" id="itemDescription" class="form-control" value="@newItem?.Description" />
            <span class="text-danger">@Html.ValidationMessage("Description")</span>
        </div>

        <div class="mb-3">
            <label>الكمية</label>
            <input name="Quantity" type="number" step="0.01" class="form-control" value="@(newItem?.Quantity ?? 1)" />
            <span class="text-danger">@Html.ValidationMessage("Quantity")</span>
        </div>

        <div class="mb-3">
            <label>سعر الوحدة</label>
            <input name="UnitPrice" id="itemUnitPrice" type="number" step="0.01" class="form-control" value="@newItem?.UnitPrice" />
            <span class="text-danger">@Html.ValidationMessage("UnitPrice")</span>
        </div>

        <button type="submit" class="btn btn-success">إضافة البند</button>
    </form>

    <script>
        document.getElementById('productSelect').addEventListener('change', function () {
            const selectedOption = this.options[this.selectedIndex];
            if (selectedOption.value) {
                document.getElementById('itemDescription').value = selectedOption.getAttribute('data-name');
                document.getElementById('itemUnitPrice').value = selectedOption.getAttribute('data-price');
            }
        });
    </script>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function openWhatsApp(invoiceId) {
            fetch(`/Invoice/WhatsAppLink/${invoiceId}`)
                .then(response => response.text())
                .then(url => {
                    if (url.startsWith('http')) {
                        window.open(url, '_blank');
                    } else {
                        alert(url);
                    }
                });
        }

        function openEmail(invoiceId) {
            fetch(`/Invoice/EmailLink/${invoiceId}`)
                .then(response => response.text())
                .then(url => {
                    if (url.startsWith('mailto:')) {
                        const link = document.createElement('a');
                        link.href = url;
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                    } else {
                        alert(url);
                    }
                });
        }
    </script>
}